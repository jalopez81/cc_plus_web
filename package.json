{
  "name": "live-captioner",
  "productName": "Live Captioner",
  "version": "1.5.22",
  "description": "Transparent desktop overlay with real-time English/Spanish captions and translation of system audio.",
  "main": "src/main.js",
  "author": "Jorge Lopez",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch-dev-plist.js",
    "prestart": "node scripts/patch-dev-plist.js",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --arch=universal"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-dmg": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.8.0",
    "electron": "^44.0.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
